---
import Icon from "./Icon.astro";

export interface Props {
  titulo: string;
  descripcion: string;
  tags: string[];
  icon?: string;
  href?: string;
  destacado?: boolean;
}

const { titulo, descripcion, tags, icon = "code", href, destacado = false } = Astro.props;
---

<article
  class={`group relative flex flex-col overflow-hidden rounded-xl border p-6 transition-all duration-300 hover:-translate-y-1 ${
    destacado
      ? "border-morado/40 bg-gris/80 hover:border-morado hover:shadow-[0_8px_40px_-8px_rgba(157,0,255,0.45)]"
      : "border-gris bg-fondo/60 hover:border-morado/60 hover:shadow-[0_8px_40px_-8px_rgba(157,0,255,0.35)]"
  }`}
>
  <span
    aria-hidden="true"
    class={`pointer-events-none absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100 ${
      destacado ? "bg-morado" : "bg-gradient-to-r from-morado to-morado/20"
    }`}
  />
  <div class="mb-4 flex items-start justify-between">
    <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-morado/30 bg-morado/10 text-morado">
      <Icon name={icon} class="h-5 w-5" />
    </span>
    {href && (
      <span class="text-texto/30 transition-all group-hover:translate-x-0.5 group-hover:text-morado">
        <Icon name="external" class="h-4 w-4" />
      </span>
    )}
  </div>
  <h3 class="mb-2 text-xl font-semibold text-white transition-colors group-hover:text-morado">
    {titulo}
  </h3>
  <p class="mb-4 flex-1 text-sm leading-relaxed text-texto/70">{descripcion}</p>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full border border-morado/30 bg-morado/10 px-3 py-1 text-xs font-medium tracking-wider text-morado">
        {tag}
      </span>
    ))}
  </div>
  {href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="absolute inset-0 rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-morado"
      aria-label={`Ver proyecto ${titulo}`}
    >
      <span class="sr-only">Ver proyecto {titulo}</span>
    </a>
  )}
</article>
