---
import "../styles/global.css";
import Navbar from "../components/astro/Navbar.astro";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const SITE_URL = "https://heri-dev.es";

const {
  title = "HeriDev — Estudiante de Desarrollo Web y Técnico Informático | Java, Astro, React",
  description = "Portfolio de Ismael Mateo Díaz Gutiérrez (HeriDev), estudiante de Desarrollo de Aplicaciones Web y técnico informático en Zaragoza: Java con certificación Oracle y proyectos web con Astro y React usando Render, Supabase, GitHub, Vercel y Cloudflare R2.",
  canonical = `${SITE_URL}/`,
} = Astro.props;

const ogImage = `${SITE_URL}/og-cover.jpg`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ismael Mateo Díaz Gutiérrez",
  alternateName: "HeriDev",
  url: SITE_URL,
  jobTitle: "Estudiante de Desarrollo de Aplicaciones Web y Técnico Informático",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Zaragoza",
    addressCountry: "ES",
  },
  sameAs: [
    "https://github.com/herizador",
    "https://www.linkedin.com/in/ismael-d%C3%ADaz-24072627a",
  ],
  telephone: "+34603177493",
  knowsAbout: ["Java", "Oracle SQL", "Astro", "React", "Supabase", "Cloudflare R2", "Vercel", "Render", "GitHub"],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="HeriDev, Ismael Díaz Gutiérrez, estudiante DAW Zaragoza, portfolio desarrollador, Java, Oracle SQL, Astro, React, Supabase, Cloudflare R2, técnico informático"
    />
    <meta name="author" content="Ismael Mateo Díaz Gutiérrez" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#9d00ff" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="HeriDev" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HeriDev — Portfolio de Ismael Mateo Díaz Gutiérrez" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="min-h-screen bg-fondo font-mono text-texto antialiased">
    <div id="scanline" aria-hidden="true" />
    <div id="scroll-progress" aria-hidden="true" />
    <Navbar />
    <main class="mx-auto max-w-6xl px-4 pb-16">
      <slot />
    </main>
    <footer class="border-t border-morado/20 py-8">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 text-xs text-texto/50 sm:flex-row">
        <p>&copy; 2026 HeriDev &middot; Ismael Mateo D&iacute;az Guti&eacute;rrez &middot; Zaragoza</p>
        <p>
          <a href="#inicio" class="transition-colors hover:text-morado">Volver arriba</a>
          <span class="mx-2 text-morado/40">/</span>
          <a href="/Ismael_CV.pdf" class="transition-colors hover:text-morado">Descargar CV</a>
        </p>
      </div>
    </footer>
    <button
      id="to-top"
      type="button"
      aria-label="Volver arriba"
      class="fixed bottom-6 right-6 z-50 hidden h-11 w-11 items-center justify-center rounded-full border border-morado/50 bg-fondo/90 text-morado shadow-[0_0_20px_rgba(157,0,255,0.35)] backdrop-blur transition-all hover:bg-morado hover:text-white"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path>
      </svg>
    </button>
    <script>
      (function() {
        // Typewriter por secciones (contrato existente) + revelado suave para tarjetas
        if (typeof IntersectionObserver !== 'undefined') {
          var twEls = document.querySelectorAll('[class*="tw-s-"]');
          var revealEls = document.querySelectorAll('.reveal');
          var show = function(el) { el.classList.add('play'); };
          var obs = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                show(entry.target);
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0, rootMargin: "80px" });
          var watch = function(el) {
            if (el.getBoundingClientRect().top < window.innerHeight + 80) {
              show(el);
            } else {
              obs.observe(el);
            }
          };
          twEls.forEach(watch);
          revealEls.forEach(watch);
        } else {
          document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('play'); });
        }
        // Barra de progreso de lectura + botón volver arriba
        var bar = document.getElementById('scroll-progress');
        var toTop = document.getElementById('to-top');
        function onScroll() {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          var pct = max > 0 ? (window.scrollY / max) * 100 : 0;
          if (bar) bar.style.transform = 'scaleX(' + pct / 100 + ')';
          if (toTop) {
            var visible = window.scrollY > 600;
            toTop.classList.toggle('hidden', !visible);
            toTop.classList.toggle('flex', visible);
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        if (toTop) {
          toTop.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      })();
    </script>
  </body>
</html>
