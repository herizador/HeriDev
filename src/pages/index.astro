---
import LayoutCyberpunk from "../layouts/LayoutCyberpunk.astro";
import CardProyecto from "../components/astro/CardProyecto.astro";
import Icon from "../components/astro/Icon.astro";
import SplineViewer from "../components/react/SplineViewer.jsx";
import Terminal from "../components/react/Terminal.jsx";
import HeroParticles from "../components/react/HeroParticles.jsx";
import { getRepos } from "../services/github";

const repos = await getRepos();
const tokenValido = import.meta.env.GITHUB_TOKEN &&
  import.meta.env.GITHUB_TOKEN !== "undefined" &&
  import.meta.env.GITHUB_TOKEN !== "";

const joyas = [
  {
    titulo: "Gestor Familiar",
    descripcion: "Cloud de almacenamiento de objetos con Cloudflare R2, base de datos e historial con Supabase, y gestión de usuarios de forma segura. Desarrollado con asistencia de IA.",
    tags: ["Cloudflare R2", "Supabase", "React", "Node.js"],
    icon: "cloud",
    href: "https://github.com/herizador/Proyecto-Gestor-Archivos",
    destacado: true,
  },
  {
    titulo: "AudioShare",
    descripcion: "Aplicación avanzada para compartir media y archivos de audio con streaming en tiempo real. Desarrollado con asistencia de IA.",
    tags: ["Audio", "Streaming", "React", "WebSockets"],
    icon: "audio",
    href: "https://github.com/herizador/AudioShare",
    destacado: true,
  },
  {
    titulo: "KidLink",
    descripcion: "Software enfocado en seguridad, educación y comunicación en entornos infantiles. Desarrollado con asistencia de IA.",
    tags: ["Seguridad", "Educación", "Comunicación"],
    icon: "shield",
    href: "https://github.com/herizador/kidlink",
    destacado: true,
  },
];

const javaProyectos = [
  {
    titulo: "Proyecto Empresa",
    descripcion: "Sistema de gestión empresarial desarrollado en Java. Demuestra POO, patrones de diseño y lógica backend robusta.",
    tags: ["Java", "POO", "Oracle SQL"],
    icon: "code",
    href: "https://github.com/herizador/Proyecto_Empresa",
  },
  {
    titulo: "Proyecto Biblioteca",
    descripcion: "Aplicación de gestión bibliotecaria que valida certificación Oracle Java y Oracle SQL.",
    tags: ["Java", "Oracle SQL", "CRUD"],
    icon: "book",
    href: "https://github.com/achrafestudios-lab/Proyecto_Biblioteca",
  },
];

const contactos = [
  {
    etiqueta: "Teléfono",
    valor: "(+34) 603 177 493",
    href: "tel:+34603177493",
    icon: "phone",
  },
  {
    etiqueta: "WhatsApp",
    valor: "Escríbeme directamente",
    href: "https://wa.me/34603177493",
    icon: "chat",
  },
  {
    etiqueta: "Email",
    valor: "heridev@proton.me",
    href: "mailto:heridev@proton.me",
    icon: "mail",
  },
  {
    etiqueta: "GitHub",
    valor: "github.com/herizador",
    href: "https://github.com/herizador",
    icon: "github",
  },
  {
    etiqueta: "LinkedIn",
    valor: "Ismael Díaz",
    href: "https://www.linkedin.com/in/ismael-d%C3%ADaz-24072627a",
    icon: "linkedin",
  },
];
---

<LayoutCyberpunk
  title="HeriDev — Estudiante de Desarrollo Web en Zaragoza | Java, Astro, React"
  description="Portfolio de Ismael Mateo Díaz Gutiérrez (HeriDev), estudiante de Desarrollo de Aplicaciones Web y técnico informático en Zaragoza: Java certificado por Oracle y proyectos web con Astro y React usando Render, Supabase, GitHub, Vercel y Cloudflare R2."
  canonical="https://heri-dev.es/"
>
  <section id="inicio" class="relative w-screen min-h-screen flex flex-col items-center justify-center overflow-hidden mb-24" style="left: 50%; transform: translateX(-50%);">
    <div class="absolute top-0 left-0 z-0 w-full h-screen">
      <HeroParticles client:only="react" />
    </div>
    <div class="relative z-10 w-full max-w-6xl mx-auto pt-24 px-4">
      <div class="w-full">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-morado/30 bg-morado/10 px-4 py-1.5 text-xs tracking-wider text-morado">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-morado opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-morado"></span>
          </span>
          Disponible para trabajar
        </p>
        <p class="mb-2 text-sm tracking-widest text-morado uppercase">Hola, soy</p>
        <h1 class="tw tw-hero mb-1 text-5xl font-bold text-morado md:text-7xl">
          HeriDev
        </h1>
        <h2 class="tw tw-name mb-4 text-4xl font-bold text-white md:text-5xl">
          Ismael Mateo <span class="text-morado">Díaz Gutiérrez</span>
        </h2>
        <p class="tw tw-tagline mb-6 text-lg text-texto/70">
          <span class="text-morado">&gt;</span> Próximo Desarrollador Web y Técnico Informático
        </p>
        <p class="tw tw-desc mb-8 max-w-xl text-sm text-texto/50 leading-relaxed">
          Técnico en Sistemas Microinformáticos y Redes · Estudiante de DAW ·
           Certificado Oracle Java y Oracle SQL · Render · Supabase · GitHub · Vercel · Cloudflare R2
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#joyas"
            class="rounded border border-morado bg-morado/10 px-6 py-2 text-sm font-medium text-morado tracking-wider transition-all hover:bg-morado hover:text-white"
          >
            Ver proyectos
          </a>
          <a
            href="#curriculum"
            class="inline-flex items-center gap-2 rounded border border-morado bg-morado px-6 py-2 text-sm font-medium text-white tracking-wider transition-all hover:bg-transparent hover:text-morado"
          >
            <Icon name="file" class="h-4 w-4" />
            Ver CV
          </a>
          <a
            href="https://github.com/herizador"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded border border-morado bg-morado/10 px-6 py-2 text-sm font-medium text-morado tracking-wider transition-all hover:bg-morado hover:text-white"
          >
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="terminal" class="mb-24">
    <div class="mb-8 flex items-center gap-3">
      <h2 class="shrink-0 text-2xl font-semibold text-white">
        <span class="text-morado">$</span> Terminal
      </h2>
      <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-morado/50 to-transparent"></span>
    </div>
    <Terminal client:visible />
  </section>

  <section id="sobre-mi" class="mb-24">
    <div class="mb-2 flex items-center gap-3">
      <h2 class="shrink-0 text-2xl font-semibold text-white">
        <span class="text-morado">#</span> Sobre mí
      </h2>
      <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-morado/50 to-transparent"></span>
    </div>
    <p class="tw tw-s-sobremi mb-8 max-w-2xl text-sm text-texto/50">
      Técnico informático en Zaragoza y estudiante de DAW: del soporte en empresa al desarrollo con Java y web.
    </p>
    <div class="grid gap-6 md:grid-cols-3">
      <article class="reveal flex flex-col rounded-xl border border-gris bg-gris/40 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-morado/60">
        <span class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-lg border border-morado/30 bg-morado/10 text-morado">
          <Icon name="user" class="h-5 w-5" />
        </span>
        <h3 class="mb-3 text-lg font-semibold text-white">Perfil profesional</h3>
        <p class="text-sm leading-relaxed text-texto/70">
          Soy <span class="kw">Ismael Mateo Díaz Gutiérrez</span> (HeriDev), técnico en
          <span class="kw">Sistemas Microinformáticos y Redes</span> y estudiante de
          <span class="kw">DAW</span> en <span class="kw">CPIFP Los Enlaces</span>. Trabajé como
          técnico informático en <span class="kw">Pikolin</span> y <span class="kw">CSIF</span>:
          mantenimiento de equipos, gestión de usuarios de red y soporte remoto.
        </p>
      </article>
      <article class="reveal flex flex-col rounded-xl border border-gris bg-gris/40 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-morado/60">
        <span class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-lg border border-morado/30 bg-morado/10 text-morado">
          <Icon name="cap" class="h-5 w-5" />
        </span>
        <h3 class="mb-3 text-lg font-semibold text-white">Formación y certificaciones</h3>
        <ul class="space-y-2 text-sm leading-relaxed text-texto/70">
          <li><span class="kw">Java</span> como lenguaje principal, con <span class="kw">Oracle Java Foundations</span> y <span class="kw">Oracle SQL</span>.</li>
          <li>Redes con <span class="kw">Cisco Networking Basics</span> (IPv4, IPv6, Ethernet).</li>
          <li>Desarrollo web con <span class="kw">Astro</span> y <span class="kw">React</span>, e <span class="kw">IA generativa</span> en mis flujos de trabajo.</li>
        </ul>
      </article>
      <article class="reveal flex flex-col rounded-xl border border-gris bg-gris/40 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-morado/60">
        <span class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-lg border border-morado/30 bg-morado/10 text-morado">
          <Icon name="briefcase" class="h-5 w-5" />
        </span>
        <h3 class="mb-3 text-lg font-semibold text-white">Experiencia y voluntariado</h3>
        <p class="text-sm leading-relaxed text-texto/70">
          En mis proyectos uso <span class="kw">Render</span>, <span class="kw">Supabase</span>,
          <span class="kw">GitHub</span>, <span class="kw">Vercel</span> y
          <span class="kw">Cloudflare R2</span>. Además soy voluntario como
          <span class="kw">monitor de ocio y tiempo libre</span>, dinamizando actividades
          socioeducativas para infancia y juventud.
        </p>
      </article>
    </div>
  </section>

  <section id="curriculum" class="mb-24">
    <div class="mb-2 flex items-center gap-3">
      <h2 class="shrink-0 text-2xl font-semibold text-white">
        <span class="text-morado">#</span> Currículum
      </h2>
      <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-morado/50 to-transparent"></span>
    </div>
    <p class="tw tw-s-curriculum mb-8 max-w-2xl text-sm text-texto/50">
      Mi trayectoria en un documento: experiencia, formación y certificaciones.
    </p>
    <div class="grid items-stretch gap-6 lg:grid-cols-5">
      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="reveal group relative block overflow-hidden rounded-xl border border-gris bg-gris/40 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-morado/60 hover:shadow-[0_8px_40px_-8px_rgba(157,0,255,0.35)] lg:col-span-2"
        aria-label="Abrir currículum en PDF en una pestaña nueva"
      >
        <div class="cv-paper relative overflow-hidden rounded-lg p-5 shadow-lg">
          <p class="text-sm font-bold text-[#6d288c]">Ismael Mateo Diaz Gutierrez</p>
          <p class="mt-1 text-[10px] leading-relaxed text-[#5a5a64]">(+34) 603 177 493 · ismel386827@gmail.com · heri-dev.es</p>
          <div class="mt-3 border-t-2 border-[#6d288c]/40 pt-2">
            <p class="text-[10px] font-bold tracking-wider text-[#6d288c]">EXPERIENCIA LABORAL</p>
            <div class="cv-paper-bar mt-1.5 h-1.5 w-11/12"></div>
            <div class="cv-paper-bar mt-1.5 h-1.5 w-10/12"></div>
            <div class="cv-paper-bar mt-1.5 h-1.5 w-11/12"></div>
          </div>
          <div class="mt-3 border-t-2 border-[#6d288c]/40 pt-2">
            <p class="text-[10px] font-bold tracking-wider text-[#6d288c]">EDUCACIÓN Y CERTIFICACIONES</p>
            <div class="cv-paper-bar mt-1.5 h-1.5 w-9/12"></div>
            <div class="cv-paper-bar mt-1.5 h-1.5 w-11/12"></div>
            <div class="cv-paper-bar mt-1.5 h-1.5 w-8/12"></div>
          </div>
          <span class="absolute bottom-3 right-3 rounded-full bg-[#6d288c] px-2.5 py-1 text-[10px] font-medium text-white">PDF · 3 páginas</span>
          <span class="absolute inset-0 flex items-center justify-center bg-fondo/0 opacity-0 transition-all duration-300 group-hover:bg-fondo/60 group-hover:opacity-100">
            <span class="inline-flex items-center gap-2 rounded border border-morado bg-fondo/90 px-4 py-2 text-xs font-medium text-morado">
              <Icon name="eye" class="h-4 w-4" />
              Vista previa
            </span>
          </span>
        </div>
      </a>
      <div class="reveal flex flex-col justify-center rounded-xl border border-gris bg-gris/40 p-6 lg:col-span-3 lg:p-8">
        <h3 class="mb-3 text-xl font-semibold text-white">CV de Ismael Mateo Díaz Gutiérrez</h3>
        <p class="mb-5 max-w-xl text-sm leading-relaxed text-texto/70">
          Técnico informático y estudiante de Desarrollo de Aplicaciones Web en Zaragoza.
          El documento incluye experiencia en <span class="kw">Pikolin</span> y
          <span class="kw">CSIF</span>, formación en <span class="kw">DAW</span> y
          <span class="kw">SMR</span>, certificaciones de <span class="kw">Oracle</span>,
          <span class="kw">Cisco</span> y <span class="kw">Coursera</span>, además de voluntariado.
        </p>
        <dl class="mb-6 grid max-w-xl grid-cols-2 gap-3 text-xs sm:grid-cols-4">
          <div class="rounded-lg border border-gris bg-fondo/60 p-3">
            <dt class="mb-1 uppercase tracking-wider text-texto/40">Formato</dt>
            <dd class="font-medium text-white">PDF</dd>
          </div>
          <div class="rounded-lg border border-gris bg-fondo/60 p-3">
            <dt class="mb-1 uppercase tracking-wider text-texto/40">Idioma</dt>
            <dd class="font-medium text-white">Español</dd>
          </div>
          <div class="rounded-lg border border-gris bg-fondo/60 p-3">
            <dt class="mb-1 uppercase tracking-wider text-texto/40">Zona</dt>
            <dd class="font-medium text-white">Zaragoza</dd>
          </div>
          <div class="rounded-lg border border-gris bg-fondo/60 p-3">
            <dt class="mb-1 uppercase tracking-wider text-texto/40">Contacto</dt>
            <dd class="font-medium text-white">603 177 493</dd>
          </div>
        </dl>
        <div class="flex flex-wrap gap-4">
          <a
            href="/cv.pdf"
            download="CV-Ismael-Mateo-Diaz-Gutierrez.pdf"
            class="inline-flex items-center gap-2 rounded border border-morado bg-morado px-6 py-2 text-sm font-medium tracking-wider text-white transition-all hover:bg-transparent hover:text-morado"
          >
            <Icon name="download" class="h-4 w-4" />
            Descargar CV
          </a>
          <a
            href="/cv.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded border border-gris px-6 py-2 text-sm font-medium tracking-wider text-texto/70 transition-all hover:border-morado hover:text-morado"
          >
            <Icon name="eye" class="h-4 w-4" />
            Abrir en pestaña nueva
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="joyas" class="mb-24">
    <div class="mb-2 flex items-center gap-3">
      <h2 class="shrink-0 text-2xl font-semibold text-white">
        <span class="text-morado">#</span> Las Joyas de la Corona
      </h2>
      <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-morado/50 to-transparent"></span>
    </div>
    <p class="tw tw-s-joyas mb-8 text-sm text-texto/50">
      Proyectos estrella que definen mi stack y filosofía de desarrollo.
    </p>
    <div class="grid gap-6 md:grid-cols-3">
      {joyas.map((proyecto) => (
        <CardProyecto {...proyecto} />
      ))}
    </div>
  </section>

  <section id="java" class="mb-24">
    <div class="mb-2 flex items-center gap-3">
      <h2 class="shrink-0 text-2xl font-semibold text-white">
        <span class="text-morado">#</span> Proyectos Java
      </h2>
      <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-morado/50 to-transparent"></span>
    </div>
    <p class="tw tw-s-java mb-8 text-sm text-texto/50">
      Lógica backend robusta y validación de certificaciones Oracle.
    </p>
    <div class="grid gap-6 md:grid-cols-2">
      {javaProyectos.map((proyecto) => (
        <CardProyecto {...proyecto} />
      ))}
    </div>
  </section>

  <section id="github" class="mb-24">
    <div class="mb-2 flex items-center gap-3">
      <h2 class="shrink-0 text-2xl font-semibold text-white">
        <span class="text-morado">#</span> Nodos de GitHub
      </h2>
      <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-morado/50 to-transparent"></span>
    </div>
    <p class="tw tw-s-github mb-8 text-sm text-texto/50">
      Repositorios públicos sincronizados en build-time.
      {!tokenValido && (
        <span class="mt-2 flex items-center gap-2 text-yellow-400">
          <Icon name="alert" class="h-4 w-4 shrink-0" />
          GITHUB_TOKEN no configurado. Sin token el rate-limit es reducido.
        </span>
      )}
    </p>
    {repos.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {repos.slice(0, 12).map((repo) => (
          <CardProyecto
            titulo={repo.name}
            descripcion={repo.description || "Sin descripción"}
            tags={[repo.language || "Varios", `${repo.stargazers_count} stars`]}
            href={repo.html_url}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-gris bg-gris/30 p-8 text-center">
        <p class="text-texto/50">No hay repositorios públicos para mostrar.</p>
      </div>
    )}
  </section>

  <section id="contacto">
    <div class="mb-2 flex items-center gap-3">
      <h2 class="shrink-0 text-2xl font-semibold text-white">
        <span class="text-morado">#</span> Contacto
      </h2>
      <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-morado/50 to-transparent"></span>
    </div>
    <p class="tw tw-s-contacto mb-8 text-sm text-texto/50">
      ¿Hablamos? Respondo en menos de 24 horas.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {contactos.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith("http") ? "_blank" : undefined}
          rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="group flex items-center gap-4 rounded-xl border border-gris bg-gris/40 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-morado/60 hover:shadow-[0_8px_40px_-8px_rgba(157,0,255,0.35)]"
        >
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-morado/30 bg-morado/10 text-morado transition-colors group-hover:bg-morado group-hover:text-white">
            <Icon name={c.icon} class="h-5 w-5" />
          </span>
          <span class="min-w-0">
            <span class="block text-xs uppercase tracking-wider text-texto/40">{c.etiqueta}</span>
            <span class="block truncate text-sm font-medium text-white group-hover:text-morado">{c.valor}</span>
          </span>
          <Icon name="external" class="ml-auto h-4 w-4 shrink-0 text-texto/30 transition-colors group-hover:text-morado" />
        </a>
      ))}
      <div class="flex items-center gap-4 rounded-xl border border-morado/40 bg-morado/10 p-5 sm:col-span-2 lg:col-span-1">
        <span class="relative flex h-3 w-3 shrink-0">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-morado opacity-60"></span>
          <span class="relative inline-flex h-3 w-3 rounded-full bg-morado"></span>
        </span>
        <p class="text-sm leading-relaxed text-texto/70">
          Zaragoza, España · Disponible para trabajar.
        </p>
      </div>
    </div>
  </section>
</LayoutCyberpunk>
